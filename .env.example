BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here
ADMIN_ID=1660218648

# Proxy (MTProto for Telegram connection)
USE_PROXY=0
PROXY_URL=tg://proxy?server=127.0.0.1&port=1443&secret=ddc2bd4edcbfe5be73399bc44163f12b20

# Proxy (SOCKS5 for downloading video/audio, also reused for the Qwen browser)
USE_SOCKS5=0
SOCKS5_PROXY=socks5://user:pass@127.0.0.1:1080

# YouTube session quality (optional but recommended)
# Cookies file in Netscape format (exported from browser; e.g. via Get-cookies.txt extension)
# YOUTUBE_COOKIES=./cookies.txt
# Automatically extract cookies from a locally installed browser
# YOUTUBE_COOKIES_FROM_BROWSER=chrome
# Extra yt-dlp extractor args, comma-separated (po_token, skip=consent etc.)
# Default player clients are web,ios; android client is avoided (its media URLs
# get HTTP 403 through datacenter SOCKS5 proxies).
# YOUTUBE_EXTRACTOR_ARGS=po_token=...,skip=consent
# Requires a JS runtime (node/deno) on PATH and the yt-dlp-ejs package
# (installed automatically via yt-dlp[default]) to solve YouTube's n-challenge.

# Whisper model cache dir (optional, defaults to ~/.cache/whisper)
# WHISPER_CACHE_DIR=./whisper_cache
